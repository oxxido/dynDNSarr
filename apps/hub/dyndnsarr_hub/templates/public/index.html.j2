*{box-sizing:border-box}body{margin:0;background:linear-gradient(180deg,var(--bg-top),var(--bg) 55%,var(--bg));color:var(--fg); min-height:100vh;transition:color .2s,background .2s}button,select{font:inherit}button{cursor:pointer}button:focus-visible,select:focus-visible,a:focus-visible{outline:3px solid #12aaf3;outline-offset:3px}
.shell{width:min(1300px,calc(100% - 56px));margin:auto}.header{height:88px;display:flex;align-items:center;justify-content:space-between;gap:18px}.brand{font-size:43px;font-weight:850;letter-spacing:-2.7px;line-height:1;color:var(--fg);white-space:nowrap}.brand b{color:#09b6ed}.brand-waves{margin-left:100px;margin-top:2px;width:80px;height:10px;background:#05c4ee;clip-path:polygon(0 70%,27% 6%,52% 62%,75% 34%,100% 16%,82% 80%,56% 98%,28% 52%)}.right-controls{display:flex;align-items:center;gap:20px}.status-pill{padding:8px 15px;border:1px solid #a2e4ce;background:color-mix(in srgb,var(--panel) 80%,#77efc1 20%);color:var(--fg);border-radius:40px;font-size:13px;font-weight:650;white-space:nowrap}.dot{display:inline-block;vertical-align:middle;width:11px;height:11px;background:var(--green);border-radius:50%;margin-right:8px;box-shadow:0 0 12px rgba(0,200,100,.45)}.slogan-small{color:var(--muted);font-size:12px;white-space:nowrap}.wave-mark{color:#00bde8;font-size:23px}.theme-select{padding:9px 32px 9px 12px;background:var(--panel);border:1px solid var(--line);color:var(--fg);border-radius:10px;max-width:120px}
.hero{min-height:390px;position:relative;display:grid;grid-template-columns:32% 38% 30%;align-items:center;overflow:hidden;isolation:isolate;margin-bottom:7px}.hero::before{content:"";position:absolute;inset:40% -5% 0;background:radial-gradient(ellipse at 53% 100%,var(--glow),transparent 63%);z-index:-2}.hero::after{content:"";position:absolute;bottom:10px;left:-5%;right:-5%;height:95px;opacity:.68;background:repeating-radial-gradient(ellipse 200px 50px at 55% 130%, transparent 0 17px,rgba(24,172,228,.09) 19px 22px,transparent 24px 37px);z-index:-1;pointer-events:none}.hero-copy{padding:8px 0 26px 28px;z-index:2}.overline{font-size:31px;line-height:1.2;font-weight:750;letter-spacing:-1.1px}.hero h1{font-size:clamp(48px,5.1vw,74px);letter-spacing:-3px;line-height:1;margin:9px 0 20px;color:#05b86b}.hero-copy p{font-size:17px;line-height:1.65;color:var(--muted);max-width:330px;margin:0}.hero-center{align-self:end;display:flex;align-items:flex-end;justify-content:center;position:relative}.big-mascot{width:min(100%,392px);filter:drop-shadow(0 14px 22px rgba(0,188,121,.18));animation:none}.hero-side{align-self:center;display:flex;flex-direction:column;align-items:center;gap:28px;position:relative;z-index:2}.handwriting{font-family:"Brush Script MT","Segoe Script",cursive;font-size:39px;font-style:italic;color:#4a91d8;line-height:.96;transform:rotate(-8deg);text-align:center}.side-mascots{display:flex;align-items:flex-end;justify-content:center;gap:8px;width:100%}.mini{display:flex;flex-direction:column;align-items:center;width:48%;font-size:13px;font-weight:720;gap:4px}.mini img{width:min(100%,164px);filter:drop-shadow(0 8px 11px rgba(30,57,70,.15));transition:transform .2s}.mini:hover img{transform:none}.mini.orange{color:#ee7717}.mini.red{color:#ed3c60}
.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-top:3px}.panel{border:1px solid var(--line);background:var(--panel);border-radius:var(--radius);box-shadow:var(--shadow);backdrop-filter:blur(6px)}.metric{min-height:139px;padding:20px 22px;display:flex;align-items:center;gap:20px}.ring{width:58px;height:58px;min-width:58px;border:2px solid currentColor;border-radius:50%;display:grid;place-items:center;font-size:32px;box-shadow:0 0 16px color-mix(in srgb,currentColor 25%,transparent)}.ring.green{color:#06c37a}.ring.blue{color:#0c9be9}.metric h2{font-weight:600;font-size:16px;color:var(--muted);margin:0 0 5px}.metric strong{font-size:26px;line-height:1.2;display:block;letter-spacing:-.65px}.metric strong.green{color:#05a85e}.metric p{font-size:14px;line-height:1.45;color:var(--muted);margin:5px 0 0}.detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:14px 0}.detail-panel{padding:18px 18px 14px}.section-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:15px}.section-title{display:flex;align-items:center;gap:11px;font-size:18px;font-weight:750}.section-icon{color:#079ce7;font-size:25px}.section-sub{color:var(--muted);font-size:12px;text-align:right}.record{height:36px;border:1px solid color-mix(in srgb,var(--line) 67%,transparent);background:var(--row);border-radius:10px;margin-bottom:3px;display:flex;align-items:center;gap:12px;padding:3px 10px;font-size:13px}.tick{width:20px;height:20px;min-width:20px;display:grid;place-items:center;background:linear-gradient(160deg,#0cbd78,#00a86b);border-radius:50%;color:white;font-weight:900;font-size:14px}.domain{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:520}.date{color:var(--muted);white-space:nowrap;margin-right:5px}.mini-badge{font-size:12px;min-width:82px;text-align:center;background:color-mix(in srgb,var(--green) 12%,var(--panel));padding:5px 10px;border-radius:24px;color:#069458;font-weight:650}.connect-record .domain{font-size:14px}.history{padding:20px 22px 14px;margin-bottom:25px}.legend{display:flex;gap:20px;align-items:center;color:var(--muted);font-size:12px}.legend i{display:inline-block;width:13px;height:13px;border-radius:50%;margin-right:6px;vertical-align:-2px}.hist-bars{display:grid;grid-template-columns:repeat(84,minmax(0,1fr));gap:4px;margin:16px 3px 9px}.bar{height:20px;border:0;border-radius:3px;background:#35d891;padding:0;min-width:0;transition:transform .12s,filter .12s}.bar:hover,.bar:focus-visible{transform:scaleY(1.3);filter:brightness(1.1)}.bar.warn{background:#ffbc42}.bar.bad{background:#fa5475}.bar.unknown{background:#859bb4}.history-dates{display:flex;justify-content:space-between;color:var(--muted);font-size:12px}.footer{padding:6px 0 20px;text-align:center;color:var(--muted);font-size:12px}.state-red .hero h1,.state-red .metric strong.green{color:var(--red)}.state-orange .hero h1,.state-orange .metric strong.green{color:#d78b04}.state-unknown .hero h1,.state-unknown .metric strong.green{color:var(--muted)}.state-red .ring.green{color:var(--red)}.state-orange .ring.green{color:var(--amber)}.state-unknown .ring.green{color:var(--muted)}.hero-main-img{transition:opacity .25s}
