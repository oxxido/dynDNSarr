<html lang="es" data-theme="light">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark"><title>DynDNSarr — Estado del servicio</title>
<script nonce="{{ nonce }}">
(function(){try{let t=localStorage.getItem('dyndnsarr-theme')||'system';document.documentElement.dataset.theme=t==='system'?(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'):t;}catch(e){}})();
</script>
<style nonce="{{ nonce }}">
:root{font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; font-synthesis:none; --green:#08b86a;--amber:#ffad2c;--red:#f63e68; --blue:#078fdf; --radius:16px;scroll-behavior:smooth}
html[data-theme="light"]{--bg:#f4faff;--bg-top:#fbfeff;--fg:#10234b;--muted:#667eaa;--panel:#ffffffec;--line:#d7e9f7;--row:#f8fcff;--shadow:0 8px 25px rgba(29,107,164,.085);--shade:#e3f5ff;--glow:rgba(69,193,246,.22);--surface-inverse:#07172d}
