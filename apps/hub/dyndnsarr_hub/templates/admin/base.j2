<!doctype html>
<html lang="es" data-theme="light">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{% block title %}Administración{% endblock %} · DynDNSarr</title>
<script nonce="{{ nonce }}">(()=>{try{const t=localStorage.getItem('dyndnsarr-theme')||'system';document.documentElement.dataset.theme=t==='system'?(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'):t}catch(e){}})();</script>
<style nonce="{{ nonce }}">
:root{font-family:Inter,ui-sans-serif,system-ui,sans-serif;color-scheme:light;--bg:#f4faff;--fg:#10234b;--muted:#667eaa;--panel:#fff;--line:#d7e9f7;--row:#f8fcff;--blue:#078fdf;--green:#07985d;--amber:#9b6200;--red:#d12950}
html[data-theme=dark]{color-scheme:dark;--bg:#071425;--fg:#e8f3ff;--muted:#96afd0;--panel:#0e243b;--line:#20415e;--row:#102c47;--blue:#36b9ff;--green:#40dc97;--amber:#ffbc42;--red:#ff7895}
*{box-sizing:border-box}body{margin:0;background:linear-gradient(160deg,var(--row),var(--bg) 45%);color:var(--fg);min-height:100vh}a{color:var(--blue)}button,input,textarea,select{font:inherit}button,select{cursor:pointer}button,input,textarea,select{border:1px solid var(--line);border-radius:9px;background:var(--row);color:var(--fg);padding:10px}button{background:#078fdf;color:#fff;border-color:#078fdf;font-weight:650}button.secondary{background:var(--row);color:var(--fg);border-color:var(--line)}button:disabled{opacity:.55;cursor:default}:focus-visible{outline:3px solid #12aaf3;outline-offset:3px}label{display:flex;flex-direction:column;gap:7px;font-size:14px;font-weight:550}input,textarea{width:100%}textarea{min-height:82px;resize:vertical}h1{font-size:32px;letter-spacing:-1px;margin:6px 0 12px}h2{font-size:19px;margin:0 0 15px}h3{font-size:16px;margin:0 0 10px}p{line-height:1.6}small,.muted{color:var(--muted)}.shell{max-width:1300px;width:calc(100% - 48px);margin:auto}.header{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:25px 0}.brand{font-size:32px;letter-spacing:-1.8px;font-weight:850;color:var(--fg);text-decoration:none}.brand b{color:#09b6ed}.controls,.actions,.filters{display:flex;flex-wrap:wrap;align-items:end;gap:12px}.controls label{font-size:12px}nav{display:flex;gap:8px;flex-wrap:wrap;border-bottom:1px solid var(--line);padding:0 0 16px;margin-bottom:25px}nav a{padding:10px 15px;text-decoration:none;border-radius:10px;color:var(--muted)}nav a[aria-current=page]{background:var(--panel);color:var(--blue);box-shadow:0 3px 12px #078fdf13}.panel{background:var(--panel);border:1px solid var(--line);box-shadow:0 8px 25px #1d6ba410;border-radius:16px;padding:24px;margin:18px 0}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.grid .panel{margin:0}.grid.two{grid-template-columns:repeat(2,minmax(0,1fr))}.value{font-size:26px;letter-spacing:-.5px;display:block;margin:8px 0}.badge{display:inline-block;border:1px solid currentColor;border-radius:20px;padding:5px 11px;font-size:12px}.healthy{color:var(--green)}.degraded{color:var(--amber)}.critical{color:var(--red)}.unknown{color:var(--muted)}.overflow{overflow:auto}table{width:100%;border-collapse:collapse;text-align:left;font-size:13px}th{font-weight:600;color:var(--muted)}td,th{padding:13px 10px;border-bottom:1px solid var(--line);vertical-align:top}td{overflow-wrap:anywhere}code{font-size:12px;overflow-wrap:anywhere}form.stack{display:grid;gap:18px}.fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.login{max-width:460px;margin:7vh auto}.login h1{font-size:29px}.login img{width:80px;float:right}.eyebrow{color:var(--blue);font-size:12px;text-transform:uppercase;letter-spacing:1.5px}.error{border-left:3px solid var(--red);padding:12px;color:var(--red);background:var(--row)}.notice{border-left:3px solid var(--blue);padding:12px;background:var(--row)}.record-fields{display:grid;grid-template-columns:minmax(140px,2fr) 1fr 1fr auto;gap:12px;align-items:end;padding:12px 0;border-bottom:1px solid var(--line)}.record-fields .check{flex-direction:row;align-items:center;padding-bottom:12px}.check input{width:auto}.filters{margin:16px 0}.filters label{flex:1;min-width:140px}.metrics-note{font-size:13px;max-width:800px}footer{padding:28px 0;text-align:center;color:var(--muted);font-size:12px}.empty{padding:30px;text-align:center;color:var(--muted)}.section-heading{display:flex;align-items:center;justify-content:space-between;gap:16px}.wrap{overflow-wrap:anywhere}
@media(max-width:800px){.grid{grid-template-columns:1fr}.grid.two,.fields{grid-template-columns:1fr}.header{align-items:start;gap:12px}.controls{justify-content:end}.controls form button{padding:8px}.record-fields{grid-template-columns:1fr 1fr}.shell{width:calc(100% - 28px)}.panel{padding:18px}.brand{font-size:26px}h1{font-size:27px}nav{gap:3px}nav a{padding:9px;font-size:13px}.login{margin:5vh auto}.section-heading{align-items:start;flex-direction:column}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
</style></head>
<body><div class="shell"><header class="header"><a href="/admin/" class="brand">DynDNS<b>arr</b></a><div class="controls"><label>Tema<select id="theme" aria-label="Tema"><option value="system">Sistema</option><option value="light">Claro</option><option value="dark">Oscuro</option></select></label>{% if authenticated %}<form method="post" action="/admin/logout"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="secondary">Cerrar sesión</button></form>{% endif %}</div></header>
{% if authenticated %}<nav aria-label="Administración">{% for href,label in [('/admin/','Resumen'),('/admin/records','Registros'),('/admin/history','Historial'),('/admin/diagnostics','Diagnóstico'),('/admin/config','Configuración'),('/admin/integrations','Dispositivos'),('/admin/alerts','Alertas')] %}<a href="{{ href }}" {% if path == href %}aria-current="page"{% endif %}>{{ label }}</a>{% endfor %}</nav>{% endif %}
<main>{% block content %}{% endblock %}</main><footer>DynDNSarr · Administración privada · Fechas en UTC</footer></div>
<script nonce="{{ nonce }}">
(()=>{const s=document.getElementById('theme'),m=matchMedia('(prefers-color-scheme: dark)');let t='system';try{t=localStorage.getItem('dyndnsarr-theme')||'system'}catch(e){}if(!['system','light','dark'].includes(t))t='system';s.value=t;function apply(){document.documentElement.dataset.theme=t==='system'?(m.matches?'dark':'light'):t}s.addEventListener('change',()=>{t=s.value;try{localStorage.setItem('dyndnsarr-theme',t)}catch(e){}apply()});m.addEventListener('change',apply);apply()})();
const add=document.getElementById('add-record');if(add){add.addEventListener('click',()=>{const count=document.getElementById('record-count');const n=Number(count.value);if(n>=1000)return;const fragment=document.getElementById('record-template').content.cloneNode(true);fragment.querySelectorAll('[data-field]').forEach(input=>{input.name=`record_${n}_${input.dataset.field}`});document.getElementById('record-list').append(fragment);count.value=n+1})}
</script></body></html>
