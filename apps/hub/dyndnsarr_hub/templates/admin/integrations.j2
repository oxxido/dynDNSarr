{% extends 'admin/base.j2' %}{% block content %}
{% set states={'active':'Activo','likely_active':'Probablemente activo','known':'Conocido','stale':'Sin actividad reciente','unknown':'Desconocido'} %}
{% set wake_states={'sent':'Orden enviada','booting':'En espera de arranque','reachable':'Accesible','unconfirmed':'Sin confirmar'} %}
<div class="eyebrow">LAN · Solo datos privados</div><h1>Dispositivos e integraciones</h1>
<p>Una concesión DHCP acredita un dispositivo conocido. Una consulta DNS reciente indica actividad probable. Solo una conexión TCP confirma accesibilidad.</p>
{% if not enabled %}<p class="notice">Activa la recogida de integraciones en la configuración del Hub y configura el archivo local del Agent.</p>{% endif %}
{% for a in agents %}<section class="panel"><h2>{{ a.agent_id }}</h2>
{% if a.snapshot %}<p>Pi-hole: <strong>{{ 'Desconocido' if a.stale else {'ok':'Disponible','disabled':'Desactivado','unavailable':'No disponible'}[a.snapshot.pihole] }}</strong> · Última consulta satisfactoria: {{ a.snapshot.last_success_at or 'Sin datos' }} UTC</p>
{% if a.stale %}<p class="notice">Inventario antiguo o Agent no disponible. Estos datos no confirman actividad actual.</p>{% endif %}
<h3>Dispositivos autorizados para WoL</h3><div class="overflow"><table><thead><tr><th>Dispositivo</th><th>IP / MAC</th><th>Estado / encendido</th><th>Política</th><th>Acción</th></tr></thead><tbody>
{% for d in a.snapshot.targets %}<tr><td>{{ d.name }}</td><td>{{ d.ip }}<br><code>{{ d.mac }}</code></td><td>{{ 'Desconocido' if a.stale else states[d.state] }}<br>{{ wake_states[d.wake_state] if d.wake_state else 'Sin intentos' }}</td><td>Manual: {{ 'Sí' if d.manual else 'No' }}<br>Automático: {{ 'Sí' if d.automatic else 'No' }}</td><td>{% if d.manual and not a.stale and enabled %}<form method="post" action="/admin/actions/command"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="operation_id" value="{{ a.operation_id }}"><input type="hidden" name="agent_id" value="{{ a.agent_id }}"><input type="hidden" name="type" value="wake_device"><input type="hidden" name="resource_id" value="{{ d.id }}"><button>Enviar WoL</button></form>{% else %}No disponible{% endif %}</td></tr>{% else %}<tr><td colspan="5">Sin políticas WoL.</td></tr>{% endfor %}</tbody></table></div>
<p class="muted">Enviar el paquete no confirma encendido. El Agent aplica permisos y cooldown; solo comprueba el puerto configurado.</p>
<h3>Inventario Pi-hole</h3><div class="overflow"><table><thead><tr><th>Nombre</th><th>IP / MAC</th><th>Evidencia</th><th>Última actividad / concesión</th></tr></thead><tbody>{% for d in a.snapshot.devices %}<tr><td>{{ d.name }}</td><td>{{ d.ip }}<br><code>{{ d.mac or 'Sin MAC' }}</code></td><td>{{ 'Desconocido' if a.stale else states[d.state] }}</td><td>{{ d.last_activity_at or 'Sin actividad conocida' }}<br>{{ d.lease_expires_at or 'Sin vencimiento conocido' }}</td></tr>{% else %}<tr><td colspan="4">Sin observaciones.</td></tr>{% endfor %}</tbody></table></div>
{% else %}<p class="empty">Sin inventario. Comprueba la versión y la configuración del Agent.</p>{% endif %}</section>{% else %}<p class="empty">No hay Agents registrados.</p>{% endfor %}
{% endblock %}
