{% extends 'admin/base.j2' %}
{% macro hidden(action) %}<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="operation_id" value="{{ tokens[action] }}">{% if agent %}<input type="hidden" name="agent_id" value="{{ agent.agent_id }}">{% endif %}{% endmacro %}
{% macro badge(state) %}<span class="badge {{ state }}">{{ {'healthy':'Operativo','degraded':'Degradado','critical':'Crítico','unknown':'Desconocido'}[state] }}</span>{% endmacro %}
{% macro record_fields(index, record) %}<div class="record-fields"><label>Nombre del registro<input name="record_{{ index }}_name" value="{{ record.name|default('') }}" maxlength="253" placeholder="casa.example.com"></label><label>Modo<select name="record_{{ index }}_mode"><option value="monitored" {% if record.mode|default('monitored') == 'monitored' %}selected{% endif %}>Solo monitorizar</option><option value="managed" {% if record.mode|default('') == 'managed' %}selected{% endif %}>Administrar DDNS</option></select></label><label>Proveedor<select name="record_{{ index }}_provider"><option value="">Sin proveedor</option><option value="dondominio" {% if record.provider|default('') == 'dondominio' %}selected{% endif %}>DonDominio</option></select></label><label class="check"><input type="checkbox" name="record_{{ index }}_enabled" {% if record.enabled|default(true) %}checked{% endif %}>Habilitado</label></div>{% endmacro %}
{% block content %}
<div class="eyebrow">Panel privado</div><div class="section-heading"><h1>{{ {'dashboard':'Estado de tu DNS','records':'Registros DNS','history':'Historial y auditoría','diagnostics':'Diagnóstico DNS','config':'Configuración'}[page] }}</h1>{{ badge(overall) }}</div>
{% if outcome == 'pending' %}<p class="notice" role="status">La operación está pendiente o fue rechazada. Consulta la versión aplicada, el último intento y el diagnóstico antes de reenviar.</p>{% elif outcome == 'registered' %}<p class="notice" role="status">Operación registrada.</p>{% endif %}
<form method="get" class="filters"><label>Agent<select name="agent">{% for a in agents %}<option value="{{ a.agent_id }}" {% if agent and a.agent_id == agent.agent_id %}selected{% endif %}>{{ a.agent_id }}</option>{% endfor %}</select></label><label>Periodo<select name="hours">{% for h,label in [(24,'Últimas 24 horas'),(168,'Últimos 7 días'),(720,'Últimos 30 días')] %}<option value="{{ h }}" {% if hours == h %}selected{% endif %}>{{ label }}</option>{% endfor %}</select></label>{% if page == 'history' %}<label>Registro<input name="record" value="{{ resource }}" maxlength="253"></label>{% elif agent %}<label>Registro<select name="record"><option value="">Todos / servicio</option>{% for r in agent.records %}<option {% if resource == r.name %}selected{% endif %}>{{ r.name }}</option>{% endfor %}</select></label>{% endif %}{% if page == 'history' %}<label>Tipo de evento<input name="type" placeholder="dns_verified"></label><label>Desde (UTC)<input name="since" placeholder="2026-10-20T00:00:00Z"></label><label>Hasta (UTC)<input name="until" placeholder="2026-10-20T23:59:59Z"></label>{% endif %}<button class="secondary">Consultar</button></form>
{% if not agent %}<div class="panel empty">Todavía no hay Agents habilitados. Regístralos y configura su API desde la consola del Hub.</div>{% else %}
{% if agent.snapshot.status_error %}<p class="notice">agent_unreachable · Último error: {{ agent.snapshot.status_error }}. Conservamos la última observación; esto no demuestra una caída de Internet.</p>{% endif %}
<p class="muted">{{ agent.agent_id }} · {% if agent.snapshot.status_at %}Último refresco: {{ agent.snapshot.status_at }} UTC · hace {{ agent.age_seconds }} s{% else %}Sin observaciones todavía{% endif %}</p>
{% if page == 'dashboard' %}
<div class="grid"><article class="panel"><small>Estado observado</small><strong class="value">{{ badge(agent.state) }}</strong><small>Agent {{ agent.status.version if agent.status else 'sin respuesta' }}</small></article><article class="panel"><small>IPv4 pública confirmada</small><strong class="value wrap">{{ agent.status.public_ip if agent.status and agent.status.public_ip else 'Sin datos' }}</strong><small>{{ agent.status.public_ip_confirmed_at if agent.status else 'Sin confirmación' }} UTC</small></article><article class="panel"><small>Último cambio de IP</small><strong class="value">{{ agent.last_ip_change or 'Sin datos' }}</strong><small>Disponibilidad de Internet: sin medición independiente</small></article></div>
<section class="panel"><h2>Uptime observado</h2><div class="grid"><div><small>Tiempo saludable sobre tiempo conocido</small><strong class="value">{{ ('%.2f'|format(metrics.uptime_percent) ~ ' %') if metrics.uptime_percent is not none else 'Sin datos' }}</strong></div><div><small>Cobertura de {{ hours }} h</small><strong class="value">{{ '%.2f'|format(metrics.coverage_percent) }} %</strong></div><div><small>Duración conocida / ventana</small><strong class="value">{{ metrics.known_seconds|int }} / {{ metrics.window_seconds }} s</strong></div></div><p class="metrics-note muted">Los periodos sin observaciones son desconocidos. Las observaciones repetidas no añaden comprobaciones; los huecos no cuentan como tiempo disponible.</p><div class="overflow"><table><thead><tr><th>Operativo</th><th>Degradado</th><th>Crítico</th><th>Desconocido</th></tr></thead><tbody><tr>{% for state in ['healthy','degraded','critical','unknown'] %}<td>{{ metrics.seconds[state]|int }} s</td>{% endfor %}</tr></tbody></table></div></section>
<section class="panel"><h2>Disponibilidad de respuestas observadas</h2><div class="grid two">{% for key,label in [('ip','Fuentes IPv4'),('dns','Resolvers DNS configurados')] %}{% set a = availability[key] %}<div><h3>{{ label }}</h3><strong class="value">{{ ('%.2f'|format(a.uptime_percent) ~ ' %') if a.uptime_percent is not none else 'Sin datos' }}</strong><small>Cobertura {{ '%.2f'|format(a.coverage_percent) }} % · {{ a.known_seconds|int }} s conocidos</small></div>{% endfor %}</div><p class="metrics-note muted">Mide respuestas recibidas, no conectividad independiente de Internet ni coincidencia de DNS con la IP esperada. Las páginas parciales quedan desconocidas si no acreditan un fallo.</p></section>
<section class="panel"><h2>Actividad observada por el Hub</h2><p>{{ counters.ip_changes }} cambios de IP · {{ counters.renewals }} renovaciones aceptadas · {{ counters.checks_ok }} muestras satisfactorias · {{ counters.checks_failed }} muestras fallidas (por fuente/resolver).</p><h3>Incidencias observadas</h3>{% for i in metrics.incidents %}<p>{{ i.start }} → {{ i.end }} UTC · {{ i.duration_seconds|int }} s · {{ 'Recuperación confirmada' if i.recovered else 'Final sin recuperación confirmada' }}</p>{% else %}<p class="muted">Sin incidencias en las observaciones de este periodo.</p>{% endfor %}</section>
<section class="panel"><h2>Componentes</h2>{% for a in agents %}<p><a href="/admin/?agent={{ a.agent_id }}">{{ a.agent_id }}</a> {{ badge(a.state) }} · {{ a.records|length }} registros</p>{% endfor %}{% if agent.status and agent.status.hub %}<p>Outbox: {{ agent.status.hub.pending_events }} pendientes · {{ agent.status.hub.rejected_events }} rechazados · último envío {{ agent.status.hub.last_success_at or 'desconocido' }} UTC</p>{% endif %}<p class="muted">{% for b in boot %}{{ b.key }}: {{ b.value }} · {{ b.updated_at }} UTC<br>{% endfor %}El arranque del proceso no acredita disponibilidad continua.</p></section>
{% endif %}
{% if page in ['dashboard','records'] %}<section class="panel"><h2>Estado de los registros</h2><div class="overflow"><table><thead><tr><th>Nombre</th><th>Modo / proveedor</th><th>Estado</th><th>Verificación DNS</th><th>Desde (UTC)</th><th>Reintento / error</th></tr></thead><tbody>{% for r in agent.records %}<tr><td>{{ r.name }}</td><td>{{ r.mode }}<br>{{ r.provider or '—' }}</td><td>{{ badge(r.state) }}</td><td>{{ r.verification }}</td><td>{{ r.since or 'Sin datos' }}</td><td>{{ r.next_attempt_at or '—' }}<br>{{ r.last_error_code or '—' }}</td></tr>{% else %}<tr><td colspan="6">Sin registros observados.</td></tr>{% endfor %}</tbody></table></div></section>{% endif %}
{% if page in ['dashboard','records','diagnostics'] %}<section class="panel"><h2>Acciones del Agent</h2><p class="muted">Se aplican a todos los registros habilitados de este Agent. La sincronización solo incluye registros managed y conserva la verificación posterior.</p><div class="actions"><form method="post" action="/admin/actions/refresh">{{ hidden('refresh') }}<button class="secondary">Actualizar diagnóstico</button></form><form method="post" action="/admin/actions/command">{{ hidden('command') }}<input type="hidden" name="type" value="check_dns"><button>Comprobar DNS</button></form>{% set managed = agent.records|selectattr('mode','equalto','managed')|list %}{% if managed %}<form method="post" action="/admin/actions/command">{{ hidden('command') }}<input type="hidden" name="type" value="sync_ddns"><button>Sincronizar DDNS ({{ managed|length }} managed)</button></form>{% endif %}</div></section>{% endif %}
{% if page == 'diagnostics' %}<section class="panel"><h2>Respuestas guardadas por fuente y resolver</h2><p class="muted">Consultamos las muestras del Agent, sin lanzar DNS desde el Hub. IP esperada: {{ agent.status.public_ip if agent.status else 'desconocida' }}. Solo se consultaron los resolvers externos configurados.</p>{% if agent.snapshot.diagnostics_error %}<p class="notice">Diagnóstico no disponible o no compatible: {{ agent.snapshot.diagnostics_error }}. Actualiza el Agent y reintenta.</p>{% endif %}{% if agent.snapshot.diagnostics_cursor %}<p class="notice">Hay más páginas pendientes de recopilar; esta lista y los contadores son parciales.</p>{% endif %}<div class="overflow"><table><thead><tr><th>Tipo / registro</th><th>Fuente / resolver</th><th>Observado (UTC)</th><th>Respuestas</th><th>Error</th></tr></thead><tbody>{% for o in observations %}<tr><td>{{ o.kind }}<br>{{ o.record_name or 'IPv4 pública' }}</td><td>{{ o.source }}</td><td>{{ o.observed_at }}</td><td>{{ o.ips|join(', ') or 'Sin respuesta' }}</td><td>{{ o.error_code or '—' }}</td></tr>{% else %}<tr><td colspan="5">Sin muestras recogidas.</td></tr>{% endfor %}</tbody></table></div><p class="muted">Se muestran hasta 100 muestras recientes; la paginación de la consulta al Agent se recoge en cada refresco.</p></section><section class="panel"><h2>Aceptación y verificación</h2>{% for r in diagnostic_records %}<p>{{ r.name }} · aceptado por el proveedor: {{ r.accepted_at or 'sin datos' }} · DNS verificado: {{ r.verified_at or 'sin datos' }} UTC</p>{% else %}<p>Sin actualizaciones observadas.</p>{% endfor %}</section>{% endif %}
{% if page == 'config' %}
<section class="panel"><h2>Configuración del Agent</h2><p>Activa: versión {{ agent.effective.version if agent.effective else 'desconocida' }} · deseada: {{ desired.version if desired else 'ninguna' }} · resultado del último intento: {{ observed_config.last_result if observed_config else 'sin datos' }}{% if observed_config and observed_config.last_code %} ({{ observed_config.last_code }}){% endif %}</p><p class="muted">Versión 0 significa TOML local. Las credenciales, los endpoints y las CA se administran por consola/entorno y no se envían en estos formularios. Un rechazo conserva la configuración activa.</p>
{% if agent.effective and not agent.snapshot.config_error %}{% set c = agent.effective.content %}<form method="post" action="/admin/actions/config" class="stack">{{ hidden('config') }}<input type="hidden" name="active_version" value="{{ agent.effective.version }}"><input type="hidden" name="active_hash" value="{{ agent.effective.hash|default('') }}"><input type="hidden" name="desired_version" value="{{ desired.version if desired else 0 }}"><div class="fields"><label>Intervalo de comprobación (s)<input name="check_interval_seconds" type="number" min="60" value="{{ c.check_interval_seconds }}" required></label><label>Reintento de verificación (s)<input name="verify_retry_seconds" type="number" min="1" value="{{ c['update'].verify_retry_seconds }}" required></label><label>Timeout de verificación (s)<input name="verify_timeout_seconds" type="number" min="1" value="{{ c['update'].verify_timeout_seconds }}" required></label><label>Conservar muestras en el Agent (días)<input name="samples_days" type="number" min="1" value="{{ c.retention.samples_days }}" required></label><label>Conservar eventos en el Agent (días)<input name="events_days" type="number" min="1" value="{{ c.retention.events_days }}" required></label></div><div class="fields"><label>Fuentes IPv4 (una URL por línea)<textarea name="ip_sources" required>{{ c.ip_sources.urls|join('\n') }}</textarea></label><label>Resolvers externos (uno por línea)<textarea name="resolvers" required>{{ c.dns.resolvers|join('\n') }}</textarea></label></div><div><h3>Registros</h3><p class="muted">El modo «Solo monitorizar» nunca escribe DNS y debe quedar sin proveedor. Cambiar a «Administrar DDNS» autoriza actualizaciones. Deja el nombre vacío para eliminar un registro.</p><div id="record-list">{% for r in c.records %}{{ record_fields(loop.index0,r) }}{% endfor %}{% if c.records|length < 1000 %}{{ record_fields(c.records|length,{}) }}{% endif %}</div><input type="hidden" id="record-count" name="record_count" value="{{ [c.records|length + 1,1000]|min }}"><p><button type="button" id="add-record" class="secondary">Añadir otro registro</button></p></div><button>Enviar nueva versión al Agent</button></form>
<template id="record-template"><div class="record-fields"><label>Nombre del registro<input data-field="name" maxlength="253"></label><label>Modo<select data-field="mode"><option value="monitored">Solo monitorizar</option><option value="managed">Administrar DDNS</option></select></label><label>Proveedor<select data-field="provider"><option value="">Sin proveedor</option><option value="dondominio">DonDominio</option></select></label><label class="check"><input type="checkbox" data-field="enabled" checked>Habilitado</label></div></template>
{% else %}<p class="notice">Configuración no disponible o no compatible. Actualiza el Agent y consulta su diagnóstico antes de editar.</p>{% endif %}
{% if desired %}<hr><form method="post" action="/admin/actions/resend">{{ hidden('resend') }}<input type="hidden" name="desired_version" value="{{ desired.version }}"><p>Reenviar la versión {{ desired.version }} conserva su hash y no crea otra versión.</p><button class="secondary">Reenviar versión deseada</button></form>{% endif %}</section>
{% endif %}
{% endif %}
{% if page == 'history' %}<section class="panel"><h2>Eventos del Agent</h2><div class="overflow"><table><thead><tr><th>Agent / registro</th><th>Tipo / origen</th><th>Observado (UTC)</th><th>Recibido (UTC)</th><th>Código seguro</th></tr></thead><tbody>{% for e in history.entries %}<tr><td>{{ e.agent_id }}<br>{{ e.record_name or '—' }}</td><td>{{ e.type }}<br>{{ e.origin }}</td><td>{{ e.occurred_at }}</td><td>{{ e.received_at }}</td><td>{{ e.code or '—' }}</td></tr>{% else %}<tr><td colspan="5">Sin eventos para estos filtros.</td></tr>{% endfor %}</tbody></table></div>{% if next_history %}<p><a href="/admin/history?{{ next_history }}">Siguiente página</a></p>{% endif %}</section><section class="panel"><h2>Auditoría administrativa</h2><div class="overflow"><table><thead><tr><th>Instante (UTC)</th><th>Actor / acción</th><th>Recurso / operación</th><th>Resultado</th></tr></thead><tbody>{% for a in audit %}<tr><td>{{ a.occurred_at }}</td><td>{{ a.actor }}<br>{{ a.action }}</td><td>{{ a.resource or '—' }}<br><code>{{ a.operation_id or '—' }}</code></td><td>{{ a.result }}<br>{{ a.code or '—' }}</td></tr>{% endfor %}</tbody></table></div></section>{% endif %}
{% if page == 'config' %}<section class="panel"><h2>Umbrales de monitorización del Hub</h2><p class="muted">Se aplican a nuevas evaluaciones públicas y privadas; el historial conserva la política de cada observación.</p>{% if missing_configs %}<p class="notice">No conocemos el intervalo de estos Agents: {{ missing_configs|join(', ') }}. Revisa la antigüedad máxima cuando respondan.</p>{% endif %}<form method="post" action="/admin/actions/policy" class="stack">{{ hidden('policy') }}<div class="fields"><label>Antigüedad máxima de observación (s)<input name="observation_max_seconds" type="number" min="1" max="86400" value="{{ policy.observation_max_seconds }}" required></label><label>Mismatch persistente crítico (s)<input name="critical_mismatch_seconds" type="number" min="1" max="2592000" value="{{ policy.critical_mismatch_seconds }}" required></label><label>Refresco obsoleto (múltiplo del intervalo)<input name="stale_refresh_factor" type="number" min="1" max="100" value="{{ policy.stale_refresh_factor }}" required></label></div><button>Guardar umbrales</button></form></section>{% endif %}
{% endblock %}
