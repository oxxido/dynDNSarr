{% extends 'admin/base.j2' %}{% block content %}<section class="panel"><div class="eyebrow">{{ command.agent_id }}</div><h1>Seguimiento de comando</h1><p><code>{{ command.command_id }}</code></p><p>{{ command.type }} · <strong>{{ command.status }}</strong></p><p class="muted">Solicitado por {{ command.requested_by }} · {{ command.created_at }} UTC<br>Caduca: {{ command.expires_at }} UTC</p>{% if details.code %}<p class="notice">Código de resultado: {{ details.code }}</p>{% endif %}{% for r in details.records %}<p>{{ r.name }}: {{ r.verdict }}</p>{% endfor %}<p>La aceptación del comando no acredita su ejecución. Un timeout mantiene el resultado incierto hasta recibir su estado o evento.</p><form method="post" action="/admin/actions/command-refresh"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="operation_id" value="{{ operation_id }}"><input type="hidden" name="agent_id" value="{{ command.agent_id }}"><input type="hidden" name="command_id" value="{{ command.command_id }}"><button>Consultar resultado en el Agent</button></form><p><a href="/admin/history?agent={{ command.agent_id }}">Ver historial</a></p></section>{% endblock %}
