{% extends 'admin/base.j2' %}{% block content %}
<div class="eyebrow">Entrega y recuperación</div><h1>Alertas</h1>
<p>Configura canales y reglas en el archivo local del Hub. Las credenciales se reciben por entorno. Los cambios requieren reiniciar el Hub.</p>
{% if invalid %}<p class="error">El archivo de alertas no es válido. La integración está desactivada; revisa su configuración.</p>{% endif %}
<section class="panel"><h2>Reglas activas</h2>{% for r in rules %}<p><strong>{{ r.id }}</strong> · {{ r.severity }} · {{ r.channels|join(', ') }}<br>{{ r.events|join(', ') }} · Umbral {{ r.threshold_seconds }} s · Supresión {{ r.suppress_seconds }} s<br>Recuperación: {{ r.recovery_events|join(', ') or 'No configurada' }}</p>{% else %}<p>Sin reglas configuradas.</p>{% endfor %}
<form method="post" action="/admin/integrations/test-alert"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="operation_id" value="{{ operation_id }}"><button {% if not channels %}disabled{% endif %}>Enviar aviso de prueba</button></form></section>
<section class="panel"><h2>Últimas 100 entregas</h2><div class="overflow"><table><thead><tr><th>ID / Fecha UTC</th><th>Canal / Severidad</th><th>Tipo</th><th>Resultado / Intentos</th></tr></thead><tbody>{% for r in deliveries %}<tr><td><code>{{ r[0] }}</code><br>{{ r[4] }}</td><td>{{ r[1] }} / {{ r[3] }}</td><td>{{ {'alert':'Aviso','recovery':'Recuperación','test':'Prueba'}[r[2]] }}</td><td>{{ {'pending':'Pendiente','sent':'Enviada','failed':'Fallida','cancelled':'Cancelada'}[r[6]] }} / {{ r[5] }}<br>{{ r[7] or '' }}</td></tr>{% else %}<tr><td colspan="4">Sin entregas.</td></tr>{% endfor %}</tbody></table></div><p class="muted">Una respuesta perdida puede producir un reenvío con el mismo ID. La entrega SMTP o webhook no garantiza que el destinatario haya leído el aviso.</p></section>
{% endblock %}
