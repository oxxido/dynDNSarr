{% extends 'admin/base.j2' %}{% block title %}Iniciar sesión{% endblock %}
{% block content %}<section class="panel login"><div class="eyebrow">Tu DNS, bajo control</div><h1>Iniciar sesión</h1><p class="muted">Accede al estado y la configuración de tus Agents.</p>
{% if message %}<p class="error" role="alert">{{ message }}</p>{% endif %}
{% if csrf %}<form method="post" action="/admin/login" class="stack"><input type="hidden" name="csrf" value="{{ csrf }}"><label>Usuario<input name="username" autocomplete="username" maxlength="64" required></label><label>Contraseña<input name="password" type="password" autocomplete="current-password" maxlength="128" required></label><button>Entrar</button></form>{% endif %}</section>{% endblock %}
