{% extends 'admin/base.j2' %}{% block title %}Crear administrador{% endblock %}
{% block content %}<section class="panel login"><div class="eyebrow">Primer arranque</div><h1>Crear administrador</h1><p class="muted">El código de configuración aparece en los logs del Hub como <code>admin_setup_available</code>; vale una vez y caduca a las 24 h (cada arranque emite uno nuevo).</p>
{% if message %}<p class="error" role="alert">{{ message }}</p>{% endif %}
{% if csrf %}<form method="post" action="/admin/setup" class="stack"><input type="hidden" name="csrf" value="{{ csrf }}"><label>Código de configuración<input name="setup_code" autocomplete="off" maxlength="128" required></label><label>Usuario<input name="username" autocomplete="username" maxlength="64" required></label><label>Contraseña (12–128 caracteres)<input name="password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required></label><label>Repite la contraseña<input name="password2" type="password" autocomplete="new-password" minlength="12" maxlength="128" required></label><button>Crear administrador</button></form>{% endif %}</section>{% endblock %}
