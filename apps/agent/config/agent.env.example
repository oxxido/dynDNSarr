# Configuración del Agent para la instalación asistida (scripts/install-agent.sh, slice 8).
# Copia este archivo a la raíz del clon como `agent.env`, rellénalo y ejecuta el instalador; él
# lo instala en /etc/dyndnsarr/agent.env (0640). Formato EnvironmentFile de systemd: una variable
# por línea, sin comillas, sin `export` y sin comentarios al final de una línea.
# Los tokens y los certificados TLS los genera el instalador (/etc/dyndnsarr/generated.env).

# IP (o nombre) LAN de esta Raspberry: el Agent escucha en ella y va en su certificado.
DYNDNSARR_AGENT_HOST=192.168.1.50
DYNDNSARR_AGENT_PORT=8001
DYNDNSARR_AGENT_CONFIG_FILE=/etc/dyndnsarr/agent.toml

# Código de emparejamiento con el Hub: el mismo en el .env del Hub. Genéralo con
#   openssl rand -hex 16
# Es de un solo uso; vacío, el Agent funciona sin Hub (o por el camino manual, §6 y §7).
DYNDNSARR_AGENT_PAIRING_CODE=

# Credenciales de DonDominio, solo para registros `managed` del TOML.
DYNDNSARR_AGENT_DONDOMINIO_USER=
DYNDNSARR_AGENT_DONDOMINIO_KEY=
