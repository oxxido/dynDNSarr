[Unit]
Description=DynDNSarr Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dyndnsarr
Group=dyndnsarr
# Para activar el motor DDNS, definir DYNDNSARR_AGENT_CONFIG_FILE=/etc/dyndnsarr/agent.toml en
# agent.env (docs/operations.md §5). Con ProtectSystem=strict, /etc es de solo lectura: basta.
# Las credenciales de DonDominio (registros managed) van también en agent.env (0600), nunca en
# el TOML ni en este archivo.
# La API de control del Hub (slice 3b) se activa con DYNDNSARR_AGENT_API_TOKEN, HOST (IP LAN) y los
# archivos TLS en agent.env; los certificados viven en /etc/dyndnsarr (docs/operations.md §7).
EnvironmentFile=/etc/dyndnsarr/agent.env
ExecStart=/opt/dyndnsarr/venv/bin/dyndnsarr-agent
Restart=always
RestartSec=5

# Datos en /var/lib/dyndnsarr, creado por systemd con dueño dyndnsarr.
StateDirectory=dyndnsarr
StateDirectoryMode=0700

# Endurecimiento básico y límites de recursos
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
