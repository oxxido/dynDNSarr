# Ejemplo de configuración. No incluir secretos reales en el repositorio.
# Todas las variables son opcionales; se muestran los valores por defecto.

# --- Agent ---
# Copiar a /etc/dyndnsarr/agent.env (formato EnvironmentFile de systemd: sin comillas ni `export`).
# Escucha solo en loopback; para que el Hub (otra máquina) llegue al Agent, usar la IP LAN
# de la Raspberry y restringir el origen con el firewall.
DYNDNSARR_AGENT_HOST=127.0.0.1
DYNDNSARR_AGENT_PORT=8001
DYNDNSARR_AGENT_DATA_DIR=/var/lib/dyndnsarr
DYNDNSARR_AGENT_LOG_LEVEL=INFO
# Motor DDNS (slice 2a): TOML con registros, fuentes de IP y resolvers, sin secretos (ver
# apps/agent/config/agent.example.toml y docs/operations.md §5). Sin esta variable el motor
# queda desactivado; con ella, un archivo ausente o inválido impide arrancar.
# DYNDNSARR_AGENT_CONFIG_FILE=/etc/dyndnsarr/agent.toml
# Credenciales de DonDominio (slice 2b), solo para registros `mode = "managed"`. Usuario DonDNS y
# su clave; nunca en el TOML ni en el repositorio. agent.env debe ser 0600. Un registro managed
# habilitado sin ellas impide arrancar.
DYNDNSARR_AGENT_DONDOMINIO_USER=
DYNDNSARR_AGENT_DONDOMINIO_KEY=
# Token del Agent ante el Hub (slice 3a), solo si el TOML tiene la sección [hub]. Se obtiene con
# `dyndnsarr-hub agent-add <agent_id>` y se muestra una sola vez. agent.env debe ser 0600. Con
# [hub] y sin token el Agent no arranca.
DYNDNSARR_AGENT_HUB_TOKEN=
# API de control del Hub (slice 3b, docs/operations.md §7). Sin token no existe `/internal`. Se
# obtiene con `dyndnsarr-hub agent-api-token <agent_id>` (distinto del HUB_TOKEN) y se muestra una
# sola vez. Con token y DYNDNSARR_AGENT_HOST fuera de loopback el Agent no arranca sin TLS: los dos
# archivos TLS van juntos (certificado firmado por la CA local de §7.1). Exige CONFIG_FILE.
DYNDNSARR_AGENT_API_TOKEN=
# Sin valor no se definen (una ruta vacía no es «sin archivo»): descomenta con las rutas reales.
# DYNDNSARR_AGENT_TLS_CERT_FILE=/etc/dyndnsarr/agent.pem
# DYNDNSARR_AGENT_TLS_KEY_FILE=/etc/dyndnsarr/agent.key

# --- Hub ---
# Fuera de Docker: las mismas variables con prefijo DYNDNSARR_HUB_ (HOST, PORT, DATA_DIR, LOG_LEVEL)
# y, para llamar a los Agents (slice 3b), AGENT_CA_FILE: la CA que firma sus certificados.
# Con Docker Compose (apps/hub/compose.yaml) se leen desde un `.env` junto al compose.yaml:
# IP del servidor en la que se publica el puerto (127.0.0.1 = solo local) y puerto publicado.
DYNDNSARR_HUB_BIND=127.0.0.1
DYNDNSARR_HUB_PORT=8000
DYNDNSARR_HUB_LOG_LEVEL=INFO
# CA de los Agents dentro del contenedor (slice 3b). Por defecto /data/agent-ca.pem: cópiala con
# `docker compose cp agent-ca.pem hub:/data/agent-ca.pem` (docs/operations.md §7.1).
# DYNDNSARR_HUB_AGENT_CA_FILE=/data/agent-ca.pem
# Landing pública (slice 4, docs/operations.md §8): GET / y GET /public/v1/status, sin login.
# PUBLIC_ENABLED=false las desactiva (404). SHOW_DOMAINS=true añade el nombre del registro a cada
# renovación: ese nombre resuelve a la IP completa en el DNS público. STATUS_REFRESH_SECONDS es
# cada cuánto consulta el Hub el estado de los Agents con API configurada (mínimo 15).
DYNDNSARR_HUB_PUBLIC_ENABLED=true
DYNDNSARR_HUB_PUBLIC_SHOW_DOMAINS=false
DYNDNSARR_HUB_STATUS_REFRESH_SECONDS=60

# Administración privada (slice5, docs/operations.md §9). Descomenta con el origen HTTPS real,
# sin ruta; vacío/sin definir no permite login. No es una credencial ni un endpoint del Agent.
# DYNDNSARR_HUB_ADMIN_ORIGIN=https://dyndnsarr-admin.example.net
# El administrador se crea con `dyndnsarr-hub admin-create <usuario>` (contraseña oculta),
# nunca con variables de entorno ni valores por defecto.
